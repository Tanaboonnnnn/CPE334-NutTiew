# =====================================================================
# CPE334 NutTiew — environment configuration example (safe placeholders)
# Copy to `.env` and replace every placeholder. Never commit real secrets.
# API, Prisma CLI, seed, and Playwright E2E tests read this root `.env`
# (see apps/api/src/config.ts, apps/api/prisma.config.ts, and e2e/).
# The Vite web client (apps/web/src/) does not read these variables.
# `.gitignore` excludes `.env` / `.env.*` (except this example); never
# commit generated keys, passwords, or real connection strings.
# =====================================================================

# --- Database ----------------------------------------------------------
# Migration/admin-only credential used by Prisma CLI/migrations.
# Reserved for admin CLI: the API runtime must never use this URL.
DATABASE_URL=postgresql://nuttiew_owner:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/nuttiew?schema=public

# Required: explicitly provisioned non-owner API runtime account.
# Auth/session/rate tables: SELECT, INSERT, UPDATE, DELETE. Slot and Booking:
# SELECT, INSERT; Slot additionally needs column-level UPDATE ("id") solely
# for SELECT ... FOR UPDATE row locks. See README database role grants.
# API startup and db:seed fail closed without this or if it equals DATABASE_URL.
DATABASE_URL_APP=postgresql://nuttiew_runtime:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/nuttiew?schema=public

# Optional test-only guard probe role; never configure this for production.
# DATABASE_URL_BOOKING_PROBE=postgresql://nuttiew_booking_probe:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/nuttiew?schema=public

# --- Authentication / security secrets (>= 32 random bytes, hex, 64+ chars) ------
# HMAC key for CSRF token signing and rate-limit hashing; keep secret and unique.
AUTH_CSRF_HMAC_KEY=REPLACE_WITH_64_PLUS_HEX_CHARACTERS
AUTH_RATE_KEY=REPLACE_WITH_DIFFERENT_64_PLUS_HEX_CHARACTERS

# Canonical same-origin for cookie/CSRF protection. In local development use
# http://localhost:5173. Behind HTTPS in a container/cloud set this to the
# public https URL of the UI (same-origin UI/API); cookies are marked Secure
# only when NODE_ENV=production. Keep the scheme and port exact.
AUTH_CANONICAL_ORIGIN=http://localhost:5173

# CSRF key rotation: keep the old key until all 8-hour sessions expire.
AUTH_CSRF_KEY_VERSION=v1
# AUTH_CSRF_PREVIOUS_KEY_VERSION=v1
# AUTH_CSRF_PREVIOUS_HMAC_KEY=REPLACE_WITH_OLD_64_PLUS_HEX_CHARACTERS

# Comma-separated list of trusted reverse-proxy/load-balancer IPs whose
# X-Forwarded-For is honored for rate-limit client-IP buckets. Leave empty when
# clients reach the API directly. Example: AUTH_TRUSTED_PROXIES=10.0.0.10,10.0.0.11
AUTH_TRUSTED_PROXIES=

# --- Runtime -----------------------------------------------------------
# API listens on 0.0.0.0 so a container/load balancer can reach it; PORT is
# taken from the environment (defaults to 3001 for local development).
NODE_ENV=development
PORT=3001

# --- Seed (apps/api/prisma/seed.ts) ------------------------------------
# Idempotent demo-user bootstrap through DATABASE_URL_APP only. Password must
# be >= 12 UTF-8 bytes; role is Customer|Tutor. Never commit real credentials.
# SEED_EMAIL=tutor.demo@example.test
# SEED_PASSWORD=REPLACE_WITH_12_PLUS_CHAR_PASSWORD
# SEED_ROLE=Tutor

# --- Docker / docker-compose (GH-02) -----------------------------------
# Read by docker-compose.yml (and compose/db-init.sh) from this root .env.
# These passwords are created ONCE inside the Compose PostgreSQL container and
# must be distinct from each other. Never commit real values.
# compose/db-init.sh REJECTS the REPLACE_WITH_... placeholders below: replace
# each with a generated strong secret before `docker compose up`, e.g.:
#   openssl rand -hex 32   # 64 hex chars, URL-safe
# POSTGRES_PASSWORD is the Compose DB superuser; DB_OWNER_PASSWORD is the
# migration/admin role; DB_RUNTIME_PASSWORD is the restricted API runtime role.
# All three must be distinct; owner and runtime must be 16-64 URL-safe chars.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_POSTGRES_SUPERUSER_PASSWORD
DB_OWNER_PASSWORD=REPLACE_WITH_PRIVATE_OWNER_PASSWORD
DB_RUNTIME_PASSWORD=REPLACE_WITH_PRIVATE_RUNTIME_PASSWORD
# Host port mapped to the container UI/API (defaults to 3001). The API's internal
# PORT stays 3001; AUTH_CANONICAL_ORIGIN mirrors this host port in Compose.
NUTTIEW_HTTP_PORT=3001
# Set inside the image to the built React UI directory; overridable.
# WEB_DIST=/app/apps/web/dist
# Optional: reuse an existing Docker volume by its exact name (e.g. an earlier
# GH-02 volume "nuttiew_pg_data"). Leave commented/empty for project-scoped
# naming ("<project>_nuttiew_pg_data"). Before reusing, stop the project/service
# that currently mounts that volume; never mount one PG data volume into two
# running db containers. Existing data is never deleted, copied or migrated.
# NUTTIEW_DB_VOLUME=nuttiew_pg_data

# Development-only example. Do not reuse local credentials in production.

# =====================================================================
# CPE334 NutTiew — deployment configuration (GH-05, Issue #68)
# ---------------------------------------------------------------------
# These NUTTIEW_* variables configure the deployment scripts and the GitHub
# Actions CD workflow (deploy/deploy.sh, deploy/release.sh,
# .github/workflows/deploy.yml). They are NOT read by the local application;
# they are provided at deploy-run time as environment variables (or as GitHub
# repository variables + the `demo` GitHub Environment for CI). Provide value
# placeholders only; never hard-code a real Project/secret into the repo.
#
# Required to run a deploy/release (see docs/labs/lab-05/deployment.md):
# NUTTIEW_PROJECT_ID=your-gcp-project-id
# NUTTIEW_REGION=asia-southeast1
# NUTTIEW_ARTIFACT_REPO=your-docker-repo-name
# NUTTIEW_RUNTIME_IMAGE=region-docker.pkg.dev/<project>/<repo>/nuttiew
# NUTTIEW_MIGRATE_IMAGE=region-docker.pkg.dev/<project>/<repo>/nuttiew-migrate
# NUTTIEW_SQL_INSTANCE=your-cloud-sql-instance
# NUTTIEW_SQL_DB_NAME=nuttiew
# NUTTIEW_DB_OWNER_USER=nuttiew_owner
# NUTTIEW_DB_RUNTIME_USER=nuttiew_runtime
# NUTTIEW_RUNTIME_SA_EMAIL=runtime-sa@<project>.iam.gserviceaccount.com
# NUTTIEW_MIGRATE_SA_EMAIL=migrate-sa@<project>.iam.gserviceaccount.com   (least-privilege migration identity, finding #4)
# NUTTIEW_DEPLOY_SA_EMAIL=deploy-sa@<project>.iam.gserviceaccount.com
# NUTTIEW_MIGRATE_JOB=nuttiew-migrate
# NUTTIEW_CLOUD_RUN_SERVICE=nuttiew
# NUTTIEW_ORIGIN=https://nuttiew.example.com   (exact public HTTPS origin)
# NUTTIEW_PORT=3001
# NUTTIEW_MIN_INSTANCES=0
# NUTTIEW_MAX_INSTANCES=3
# NUTTIEW_CONCURRENCY=80
#
# Cloud SQL edition/version/tier (must be a VALID combination; default below is
# shared-core ENTERPRISE, subject to region availability + Free Trial, PENDING):
# NUTTIEW_SQL_EDITION=ENTERPRISE
# NUTTIEW_SQL_VERSION=POSTGRES_15
# NUTTIEW_SQL_TIER=db-f1-micro
# NUTTIEW_SQL_STORAGE_GB=10
# NUTTIEW_SQL_BACKUP_ENABLED=false
#
# DB bootstrap prerequisite: the operator MUST confirm the Cloud SQL DB role and
# extension bootstrap was completed before migrations can run in real mode.
# NUTTIEW_DB_BOOTSTRAP_DONE=1
# NUTTIEW_SQL_POSTGRES_PASSWORD_SECRET=NAME_OF_SECRET   (postgres superuser pw; live-only, PENDING)
#
# Managed secrets (Secret Manager refs) used at deploy time:
# NUTTIEW_DATABASE_URL_SECRET=DATABASE_URL          (migration/admin, job only)
# NUTTIEW_DATABASE_URL_APP_SECRET=DATABASE_URL_APP  (restricted runtime)
# NUTTIEW_CSRF_HMAC_KEY_SECRET=AUTH_CSRF_HMAC_KEY
# NUTTIEW_RATE_KEY_SECRET=AUTH_RATE_KEY
#
# CI/CD gates (GitHub repository variables, not local):
# DEPLOY_ENABLED=true   # when absent/empty/false the CD workflow is DISABLED.
# DEPLOY_CD_READY=1     # set only by the GCP configuration session; release fails
#                       # closed unless this is 1 and WIF is configured.
# =====================================================================
